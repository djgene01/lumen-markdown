<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LumenMarkdown.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAccelerator" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveAccelerator" />
            <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="OnSaveAsAccelerator" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindAccelerator" />
            <KeyboardAccelerator Key="G" Modifiers="Control" Invoked="OnGotoAccelerator" />
            <KeyboardAccelerator Key="P" Modifiers="Control,Shift" Invoked="OnLayoutAccelerator" />
            <KeyboardAccelerator Key="L" Modifiers="Control,Shift" Invoked="OnThemeAccelerator" />
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnCloseDocumentAccelerator" />
            <KeyboardAccelerator Key="F5" Invoked="OnReloadAccelerator" />
            <KeyboardAccelerator Key="F1" Invoked="OnAboutAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="TitleBarRow" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="DragRegion" Grid.Column="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/app-icon.png" Width="18" Height="18" />
                    <TextBlock x:Name="TitleText" Text="Lumen Markdown" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Text="" FontSize="12" Opacity="0.7" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Command bar -->
        <Grid Grid.Row="1" Padding="12,2,12,8">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="OpenButton" Click="OnOpenClick" ToolTipService.ToolTip="Open a Markdown file (Ctrl+O)">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="Open" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Click="OnSaveClick" IsEnabled="False" ToolTipService.ToolTip="Save (Ctrl+S)">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveAsButton" Click="OnSaveAsClick" IsEnabled="False" ToolTipService.ToolTip="Save as (Ctrl+Shift+S)">
                    <TextBlock Text="Save as" />
                </Button>
                <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="6,4" />
                <Button x:Name="UndoButton" Click="OnUndoClick" IsEnabled="False" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A7;" FontSize="14" />
                </Button>
                <Button x:Name="RedoButton" Click="OnRedoClick" IsEnabled="False" ToolTipService.ToolTip="Redo (Ctrl+Y)">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A6;" FontSize="14" />
                </Button>
                <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="6,4" />
                <Button x:Name="FindButton" Click="OnFindClick" IsEnabled="False" ToolTipService.ToolTip="Find (Ctrl+F)">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE721;" FontSize="14" />
                        <TextBlock Text="Find" />
                    </StackPanel>
                </Button>
                <Button x:Name="GotoButton" Click="OnGotoClick" IsEnabled="False" ToolTipService.ToolTip="Go to line (Ctrl+G)">
                    <TextBlock Text="Go to line" />
                </Button>
                <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="6,4" />
                <Button x:Name="LayoutButton" ToolTipService.ToolTip="Change layout (Ctrl+Shift+P)">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Split" Click="OnLayoutSplitClick" />
                            <MenuFlyoutItem Text="Editor only" Click="OnLayoutEditorClick" />
                            <MenuFlyoutItem Text="Preview only" Click="OnLayoutPreviewClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE89F;" FontSize="14" />
                        <TextBlock x:Name="LayoutLabel" Text="Split" />
                    </StackPanel>
                </Button>
                <Button x:Name="ThemeButton" Click="OnThemeClick" ToolTipService.ToolTip="Toggle theme (Ctrl+Shift+L)">
                    <FontIcon x:Name="ThemeIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE706;" FontSize="14" />
                </Button>
                <Button Click="OnAboutClick" ToolTipService.ToolTip="About and shortcuts (F1)">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Document area -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar x:Name="Info" Grid.Row="0" IsOpen="False" IsClosable="True" Margin="12,0,12,8" />

            <Grid Grid.Row="1">
                <!-- Start surface -->
                <Grid x:Name="StartSurface" Padding="32,8,32,32">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Spacing="18">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="44" Opacity="0.55" />
                        <TextBlock Text="Read and edit Markdown" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Drop a Markdown file here, or open one from disk."
                                   HorizontalAlignment="Center" TextWrapping="Wrap" Opacity="0.7" TextAlignment="Center" />
                        <Button Content="Open file" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center"
                                Click="OnOpenClick" Padding="22,9" />
                        <TextBlock Text="Recent files" FontSize="13" FontWeight="SemiBold" Margin="0,18,0,0" Opacity="0.75" />
                        <ListView x:Name="RecentList" Height="190" IsItemClickEnabled="True" ItemClick="OnRecentItemClick"
                                  SelectionMode="None" BorderThickness="0" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="2,6">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" />
                                        <TextBlock Text="{Binding Folder}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="NoRecentText" Text="No recent files yet." FontSize="12" Opacity="0.55" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Document -->
                <Grid x:Name="DocumentGrid" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="EditorColumn" Width="*" />
                        <ColumnDefinition x:Name="SplitterColumn" Width="7" />
                        <ColumnDefinition x:Name="PreviewColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Find bar -->
                        <Grid x:Name="FindBar" Grid.Row="0" Visibility="Collapsed" Padding="10,8" ColumnSpacing="6"
                              Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FindBox" Grid.Column="0" PlaceholderText="Find in document" TextChanged="OnFindTextChanged"
                                     KeyDown="OnFindBoxKeyDown" />
                            <TextBlock x:Name="FindCount" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Opacity="0.7" Margin="4,0" />
                            <Button Grid.Column="2" Click="OnFindPreviousClick" ToolTipService.ToolTip="Previous (Shift+Enter)">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70E;" FontSize="12" />
                            </Button>
                            <Button Grid.Column="3" Click="OnFindNextClick" ToolTipService.ToolTip="Next (Enter)">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;" FontSize="12" />
                            </Button>
                            <ToggleButton x:Name="MatchCaseToggle" Grid.Column="4" Content="Aa" FontSize="12"
                                          ToolTipService.ToolTip="Match case" />
                            <Button Grid.Column="5" Click="OnFindCloseClick" ToolTipService.ToolTip="Close (Esc)">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>

                        <!-- Editor with gutter -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="GutterBorder" Grid.Column="0" Width="52"
                                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0"
                                    IsHitTestVisible="False">
                                <Canvas x:Name="GutterCanvas" SizeChanged="GutterCanvas_SizeChanged">
                                    <TextBlock x:Name="GutterText" FontFamily="Cascadia Mono, Consolas" FontSize="14"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextAlignment="Right" Width="44" Canvas.Left="0" Canvas.Top="10">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="GutterTransform" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Canvas>
                            </Border>
                            <RichEditBox x:Name="Editor" Grid.Column="1"
                                         AcceptsReturn="True"
                                         IsSpellCheckEnabled="False"
                                         TextWrapping="NoWrap"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="14"
                                         Padding="10,8,10,16"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         PlaceholderText="Start writing Markdown…"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         TextChanged="OnEditorTextChanged"
                                         SelectionChanged="OnEditorSelectionChanged"
                                         Loaded="OnEditorLoaded" />
                        </Grid>
                    </Grid>

                    <Border x:Name="Splitter" Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            PointerPressed="OnSplitterPressed" PointerMoved="OnSplitterMoved"
                            PointerReleased="OnSplitterReleased" PointerCanceled="OnSplitterReleased" />

                    <Grid Grid.Column="2" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                        <WebView2 x:Name="Preview" DefaultBackgroundColor="Transparent" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="3" Padding="14,0" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DirtyText" Grid.Column="0" Text="No document" FontSize="12" VerticalAlignment="Center" Opacity="0.8" />
            <TextBlock x:Name="CaretText" Grid.Column="1" Text="" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.7" />
            <TextBlock x:Name="ToastText" Grid.Column="2" Text="" FontSize="12" VerticalAlignment="Center" Margin="16,0" Opacity="0.8" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="WordText" Grid.Column="3" Text="" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" Opacity="0.7" />
            <TextBlock x:Name="EncodingText" Grid.Column="4" Text="" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" Opacity="0.7" />
            <TextBlock x:Name="ZoomText" Grid.Column="5" Text="100%" FontSize="12" VerticalAlignment="Center" Opacity="0.7" />
        </Grid>
    </Grid>
</Window>
